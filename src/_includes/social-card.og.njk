<div
  style="display: flex; flex-direction: column; width: 1200px; height: 630px; padding: 56px 72px; background: #fcfaf4; color: #284b63; font-family: 'Noto Sans TC'; border-top: 10px solid #284b63;">
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 18px;">
      <div
        style="display: flex; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 14px; background: #284b63; color: #fcfaf4; font-size: 32px;">
        F</div>
      <div style="display: flex; font-size: 30px; letter-spacing: -1px;">{{ site.name | escape }}</div>
    </div>
    <div style="display: flex; font-size: 22px; color: #4e4e4e;">{% if section == "posts" %}POSTS /
      文章{% elif section == "notes" %}NOTES / 筆記{% else %}TECH / 技術{% endif %}</div>
  </div>
  <div style="display: flex; flex-direction: column; justify-content: center; flex: 1; padding: 32px 0;">
    <div
      style="display: flex; font-size: {% if title.length > 48 %}44{% elif title.length > 32 %}54{% elif title.length > 16 %}64{% else %}80{% endif %}px; line-height: 1.35; letter-spacing: -1px; color: #2b2b2b; word-break: break-word;">
      {{ title | escape }}</div>
    {% if description %}<div
      style="display: flex; font-size: 25px; line-height: 1.6; margin-top: 22px; color: #4e4e4e;">
      {{ description | truncate(72, true) | escape }}</div>{% endif %}
  </div>
  <div
    style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #d8ddd6; padding-top: 22px; font-size: 20px;">
    <div style="display: flex;">程式・生活・心靈成長</div>
    <div style="display: flex; align-items: center; gap: 16px;">
      {% if date %}<div style="display: flex; color: #4e4e4e;">{{ date | dateISO }}</div>{% endif %}
      <div style="display: flex; width: 32px; height: 8px; border-radius: 4px; background: #84a59d;"></div>
    </div>
  </div>
</div>