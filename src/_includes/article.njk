---
layout: base.njk
---
<article>
  <header>
    <h1>{{ title | escape }}</h1>
    {% if description %}<p class="article-description">{{ description | escape }}</p>{% endif %}
    {% if date %}<p class="article-meta"><time datetime="{{ page.date | dateISO }}">{{ page.date | dateISO }}</time></p>
    {% endif %}
    {% if tags.length %}<ul class="tag-list">{% for tag in tags %}<li><a
          href="{{ tag | tagUrl }}">{{ tag | escape }}</a></li>{% endfor %}</ul>{% endif %}
    {% if heroImage %}<img src="{{ heroImage | escape }}" alt="">{% endif %}
  </header>
  {{ content | safe }}
</article>
{% if home %}<section>
  <h2>最新內容</h2>{% set entries = collections.articles.slice(0, 5) %}{% include "article-list.njk" %}
</section>{% endif %}
