<!doctype html>
<html lang="zh-TW">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title | escape }}</title>
  {% set metaDescription = description or site.description %}
  {% set shareImage = socialImage or site.image %}
  <meta name="description" content="{{ metaDescription | escape }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl(site.url) | escape }}">
  <meta property="og:site_name" content="{{ site.name | escape }}">
  <meta property="og:locale" content="zh_TW">
  <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ title | escape }}">
  <meta property="og:description" content="{{ metaDescription | escape }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl(site.url) | escape }}">
  <meta property="og:image" content="{{ shareImage | absoluteUrl(site.url) | escape }}">
  <meta property="og:image:alt" content="{{ (socialImageAlt or site.imageAlt) | escape }}">
  {% if not socialImage %}
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | escape }}">
  <meta name="twitter:description" content="{{ metaDescription | escape }}">
  <meta name="twitter:image" content="{{ shareImage | absoluteUrl(site.url) | escape }}">
  <meta name="twitter:image:alt" content="{{ (socialImageAlt or site.imageAlt) | escape }}">
  <script src="/assets/theme.js"></script>
  <link rel="stylesheet" href="/assets/vendor/katex/katex.min.css">
  <link rel="stylesheet" href="/assets/styles.css">
  <script type="module" src="/assets/mermaid.js"></script>
</head>

<body>
  <nav aria-label="主要導覽"><a class="site-brand" href="/" {% if page.url == "/" %} aria-current="page" {% endif %}>FizzyElt</a><a
      href="/posts/" {% if page.url.startsWith("/posts/") %} aria-current="page" {% endif %}>Posts</a><a href="/notes/"
      {% if page.url.startsWith("/notes/") %} aria-current="page" {% endif %}>Notes</a><a href="/tech/"
      {% if page.url.startsWith("/tech/") %} aria-current="page" {% endif %}>Techs</a><a href="/tags/"
      {% if page.url.startsWith("/tags/") %} aria-current="page" {% endif %}>Tags</a><button class="theme-toggle" type="button" hidden>
        <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
        </svg>
        <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"></path>
        </svg>
      </button></nav>
  <main>{{ content | safe }}</main>
  {% include "footer.njk" %}
</body>

</html>
