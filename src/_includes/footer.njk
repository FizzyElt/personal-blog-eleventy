<footer class="site-footer">
  <p class="footer-name">{{ site.name | escape }}</p>
  {% if site.footerLinks.length %}
  <ul class="footer-links" aria-label="個人連結">
    {% for link in site.footerLinks %}
    <li><a href="{{ link.url | escape }}" rel="me">{{ link.label | escape }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
</footer>
