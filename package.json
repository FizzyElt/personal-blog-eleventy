{
  "name": "personal-blog-eleventy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FizzyElt 的個人部落格，使用 Eleventy 與 Markdown 建置。",
  "scripts": {
    "dev": "eleventy --config=eleventy.config.ts --serve",
    "build": "eleventy --config=eleventy.config.ts",
    "watch": "eleventy --config=eleventy.config.ts --watch",
    "fixtures:generate": "node scripts/generate-markdown-fixture.ts",
    "check:markdown": "node scripts/check-markdown.ts",
    "clean": "node scripts/clean.ts",
    "prebuild": "npm run clean",
    "check:migration": "node scripts/check-migration.ts",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.browser.json",
    "predeploy": "node scripts/check-deployment.ts && npm run build && npm run check:sharing",
    "deploy": "wrangler deploy",
    "preview:cloudflare": "wrangler dev",
    "check:sharing": "node scripts/check-sharing.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@mdit/plugin-katex": "1.1.3",
    "@shikijs/markdown-it": "4.5.0",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "gray-matter": "4.0.3",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "10.0.0",
    "mermaid": "12.1.0",
    "oxfmt": "^0.72.0",
    "shiki": "4.5.0",
    "typescript": "7.0.2",
    "wrangler": "^4.149.0"
  }
}
