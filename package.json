{
  "name": "personal-blog-eleventy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FizzyElt 的個人部落格，使用 Eleventy 與 Markdown 建置。",
  "scripts": {
    "dev": "eleventy --config=eleventy.config.ts --serve",
    "build": "eleventy --config=eleventy.config.ts",
    "watch": "eleventy --config=eleventy.config.ts --watch",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.browser.json",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "preview:cloudflare": "wrangler dev",
    "build:ci": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@mdit/plugin-katex": "1.1.3",
    "@shikijs/markdown-it": "4.5.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eleventy-plugin-og-image": "4.3.0",
    "esbuild": "0.28.2",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "10.0.0",
    "mermaid": "12.1.0",
    "oxfmt": "^0.72.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "^4.149.0"
  }
}
